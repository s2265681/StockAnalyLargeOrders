# 数据库
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=stock

# ========== AI 多账号 ==========
# 默认账号：anyrouter | kalowave（推荐 kalowave）
AI_ACCOUNT=kalowave

# AnyRouter（Claude）
AI_ACCOUNT_ANYROUTER_KEY=sk-your-anyrouter-key
AI_ACCOUNT_ANYROUTER_URL=https://a-ocnfniawgw.cn-shanghai.fcapp.run
# AI_ACCOUNT_ANYROUTER_HAIKU=claude-haiku-4-5-20251001

# Kalowave（GPT）
AI_ACCOUNT_KALOWAVE_KEY=sk-your-kalowave-key
AI_ACCOUNT_KALOWAVE_URL=https://token.kalowave.com
# AI_ACCOUNT_KALOWAVE_OPUS=gpt-5.5      # 诊股、当天分析
# AI_ACCOUNT_KALOWAVE_SONNET=gpt-5.4    # 情绪周期、龙虎榜、追问
# AI_ACCOUNT_KALOWAVE_HAIKU=claude-haiku-4-5-20251001  # 涨停分组打标签

# 兼容旧变量（可选，anyrouter 会回退读取）
# CLAUDE_API_KEY=sk-your-anyrouter-key

# 定时任务邮件（盘前资讯 8:30 也会发到该邮箱，可用 MARKET_BRIEF_EMAIL 单独指定）
JOB_ALERT_EMAIL=your@email.com
MARKET_BRIEF_EMAIL=
JOB_NOTIFY_ON_SUCCESS=1
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SSL=1
SMTP_USER=your@email.com
SMTP_PASS=example
SMTP_FROM=your@email.com

# ========== 微信支付（PC Native 扫码）==========
# 商户入驻完成后，在「账户中心 → API安全」获取以下信息
WECHAT_PAY_ENABLED=0
# 小程序 AppID（个体工商户，已认证；支付用此 ID，不是网站应用）
WECHAT_APP_ID=wxdd386a2c323cecf9
# 小程序 AppSecret（公众平台→开发管理→开发设置；小程序 JSAPI 支付换 openid 用）
# 若小程序 AppID 与支付 AppID 不同，可另配 WECHAT_MP_APP_ID；否则默认复用 WECHAT_APP_ID
WECHAT_MP_APP_SECRET=your_miniprogram_app_secret
WECHAT_MCH_ID=1748571098
WECHAT_API_V3_KEY=your_32_char_apiv3_key
WECHAT_CERT_SERIAL_NO=your_cert_serial_no
WECHAT_NOTIFY_URL=https://www.stockai.xin/api/payments/wechat/notify
# 商户 API 私钥
WECHAT_PRIVATE_KEY_PATH=certs/apiclient_key.pem

# 验签方式二选一（推荐公钥模式，与商户平台「微信支付公钥」一致）：
# 公钥模式：
WECHAT_PAY_PUBLIC_KEY_PATH=certs/pub_key.pem
WECHAT_PAY_PUBLIC_KEY_ID=PUB_KEY_ID_0117485710982026072300181620002803
# 平台证书模式（旧方案，可不用）：
# WECHAT_PLATFORM_CERT_PATH=certs/wechatpay_platform.pem

# 也可直接写入 PEM 内容（多行），适合容器/CI 部署：
# WECHAT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# WECHAT_PAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ========== 微信扫码登录（开放平台「网站应用」snsapi_login）==========
# 注意：这是独立于微信支付的一套 AppID/Secret，切勿复用上面的 WECHAT_APP_ID
# 三者（AppID/AppSecret/RedirectURI）齐全时自动启用，无需单独开关
# 网站应用 AppID（开放平台→管理中心→网站应用）
WECHAT_WEB_APP_ID=wx8681fc62ad6692fb
# 网站应用 AppSecret（在网站应用详情页「生成」后填入）
WECHAT_WEB_APP_SECRET=your_website_app_secret
# 微信授权回调地址（指向后端 callback；其域名须与开放平台「授权回调域」一致）
WECHAT_WEB_REDIRECT_URI=https://www.stockai.xin/api/auth/wechat/callback
# 前端地址（回调后带 ticket 跳回此域名下的 /wechat-callback）
WECHAT_WEB_FRONTEND_URL=https://www.stockai.xin
