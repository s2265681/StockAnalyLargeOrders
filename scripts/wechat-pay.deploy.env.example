# 微信支付一键部署配置（复制为 wechat-pay.deploy.env 后填写）
# cp scripts/wechat-pay.deploy.env.example scripts/wechat-pay.deploy.env

# SSH 连接（审核通过后执行 ./scripts/deploy-wechat-pay.sh --app-id wxXXX）
SERVER_HOST=stockai.xin
SERVER_USER=root
SERVER_PORT=22
# 私钥路径，留空则用默认 ~/.ssh/id_rsa
SSH_KEY=

# 服务器项目路径
DEPLOY_ROOT=/www/StockAnalyLargeOrders

# 本地 backend/.env 路径（默认自动读取）
# LOCAL_ENV_FILE=backend/.env

# 部署后健康检查地址
PUBLIC_BASE_URL=https://www.stockai.xin
